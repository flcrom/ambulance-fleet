{
  "name": "ambulance-fleet",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "siren.flcrom.dev", "custom_domain": true },
    { "pattern": "fleet.flcrom.dev", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FLEETS",
        "class_name": "FleetStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FleetStore"
      ]
    }
  ],
  "vars": {
    "LIVE_ENABLED": "true"
  },
  "observability": {
    "enabled": false
  }
}
