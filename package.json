  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0",
