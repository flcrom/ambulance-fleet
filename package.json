  "scripts": {
    "test": "vitest run && tsc -p security/tsconfig.json && node --test security/test.mjs && npm --prefix tools/simulator ci && npm --prefix tools/simulator test && npm --prefix tools/simulator run typecheck",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "dev:worker": "wrangler dev",
    "build": "npm --prefix web ci && npm --prefix web run build",
    "test:web": "npm --prefix web test",
    "test:e2e": "npm --prefix web run test:e2e"
  },
  "keywords": [],
  "author": "",
